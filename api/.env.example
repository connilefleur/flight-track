# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to Git. They are in .gitignore.
#
# In production, set these in your host's dashboard (e.g. Vercel → Settings → Environment Variables).

# Required: your flight API key (e.g. from aviationstack.com)
AVIATIONSTACK_API_KEY=your_api_key_here

# Optional: if set, the API will only respond when the request includes this token (e.g. ?t=your-secret).
# Use a long random string. Share links like: https://yoursite.github.io/flight-track/?t=your-secret
# ALLOWED_TOKEN=optional_link_secret
